{
  "format": 1,
  "name": "Pine Ridge Rally",
  "version": "0.1.0",
  "input": {
    "throttle": [
      "key:ArrowUp",
      "key:KeyW",
      "axis:r2",
      "pad:south"
    ],
    "brake": [
      "key:ArrowDown",
      "key:KeyS",
      "axis:l2",
      "pad:west"
    ],
    "handbrake": [
      "key:Space",
      "pad:east",
      "pad:r1"
    ],
    "steer": {
      "negative": [
        "key:ArrowLeft",
        "key:KeyA",
        "axis:left_x-"
      ],
      "positive": [
        "key:ArrowRight",
        "key:KeyD",
        "axis:left_x+"
      ]
    },
    "stats": ["key:F3"],
    "menu_back": ["key:Escape"],
    "pause": [
      "key:Escape",
      "key:KeyP",
      "pad:start"
    ],
    "reset": [
      "key:KeyR",
      "pad:north"
    ],
    "view": [
      "key:KeyC",
      "pad:l1"
    ],
    "look_x": {
      "negative": ["axis:right_x-", "key:KeyQ"],
      "positive": ["axis:right_x+", "key:KeyE"]
    },
    "look_y": {
      "negative": ["axis:right_y-"],
      "positive": ["axis:right_y+"]
    },
    "tab_prev": ["key:KeyQ", "pad:l1"],
    "tab_next": ["key:KeyE", "pad:r1"],
    "art_box": ["key:F12"],
    "art_icon": ["key:F11"],
    "look_back": ["pad:thumb_r", "key:KeyB"],
    "autodrive": [
      "key:F9"
    ]
  }
}
