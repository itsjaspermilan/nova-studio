{
  "format": 1,
  "name": "Blockfield",
  "version": "0.1.0",
  "input": {
    "jump": ["key:Space", "pad:south"],
    "sneak": ["key:ShiftLeft", "pad:thumb_r"],
    "sprint": ["key:ControlLeft", "pad:thumb_l"],
