    "prev_slot": ["pad:l1"],
    "next_slot": ["pad:r1"],
    "fly": ["key:KeyF"],
    "stats": ["key:F3", "pad:select"],
    "slot_1": ["key:Digit1"],
    "slot_2": ["key:Digit2"],
    "slot_3": ["key:Digit3"],
    "slot_4": ["key:Digit4"],
    "slot_5": ["key:Digit5"],
    "slot_6": ["key:Digit6"],
    "slot_7": ["key:Digit7"],
    "slot_8": ["key:Digit8"],
    "slot_9": ["key:Digit9"]
  }
}
