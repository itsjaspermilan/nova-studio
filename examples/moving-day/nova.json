{
  "format": 1,
  "name": "Moving Day",
  "version": "0.1.0",
  "world_height": 810,
  "sprite_filter": "smooth",
  "input": {
    "move_x": {
      "negative": ["key:ArrowLeft", "key:KeyA", "axis:left_x-", "pad:dpad_left"],
      "positive": ["key:ArrowRight", "key:KeyD", "axis:left_x+", "pad:dpad_right"]
    },
    "move_y": {
      "negative": ["key:ArrowUp", "key:KeyW", "axis:left_y-", "pad:dpad_up"],
      "positive": ["key:ArrowDown", "key:KeyS", "axis:left_y+", "pad:dpad_down"]
    },
    "left": ["key:ArrowLeft", "key:KeyA", "pad:dpad_left", "axis:left_x-"],
    "right": ["key:ArrowRight", "key:KeyD", "pad:dpad_right", "axis:left_x+"],
    "up": ["key:ArrowUp", "key:KeyW", "pad:dpad_up", "axis:left_y-"],
    "down": ["key:ArrowDown", "key:KeyS", "pad:dpad_down", "axis:left_y+"],
    "a": ["key:Space", "key:KeyZ", "key:Enter", "pad:south"],
    "b": ["key:Backspace", "key:KeyX", "pad:east"],
    "x": ["key:KeyR", "key:KeyC", "pad:west"],
    "y": ["key:KeyQ", "key:KeyV", "pad:north"],
    "l1": ["key:PageUp", "key:Digit1", "pad:l1"],
    "r1": ["key:PageDown", "key:Digit2", "pad:r1"],
    "start": ["key:Escape", "key:KeyP", "pad:start"],
    "select": ["key:Tab", "pad:select"],
    "stats": ["key:F3"],
    "selftest": ["key:F10"],
    "autoplay": ["key:F9"],
    "art_box": ["key:F12"],
    "art_icon": ["key:F11"]
  }
}
