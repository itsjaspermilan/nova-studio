{
  "size": "1280x720",
  "start_scene": "office",
  "lua": "T = require('lib.testkit')",
  "route": [
    { "wait": 30, "capture": "office" },
    { "walk_to": [2.6, 1.1], "capture": "at the shelf" },
    { "press": "interact" },
    { "wait": 40, "capture": "taken, no popup" },
    { "walk_to": [0.9, 1.6] },
    { "hold": ["down"], "until": "nova.scene_now().leaving ~= nil", "max": 200 },
    { "until": "nova.current_scene() == 'valley'", "max": 120 },
    { "wait": 30, "capture": "out on the porch" },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():actions() == 'load'", "max": 60, "capture": "Load package" },
    { "press": "interact" },
    { "wait": 10, "capture": "loaded" },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 2400, "capture": "Get in" },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van'", "max": 60, "capture": "in the van" },
    { "lua": "T.drive('hazel')" },
    { "until": "T.arrived()", "max": 3000, "capture": "at No. 3" },
    { "press": "van" },
    { "wait": 2, "capture": "got out" },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():picker() ~= nil", "max": 60, "capture": "the panel at the back" },
    { "press": "confirm" },
    { "wait": 10 },
    { "lua": "T.lead('hazel')" },
    { "until": "not T.walking()", "max": 900, "capture": "at Hazel's" },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 200 },
    { "press": "interact" },
    { "wait": 50, "capture": "Hazel 1" },
    { "repeat": 30, "until": "require('lib.state').delivered.hazel", "steps": [ { "press": "interact" }, { "wait": 40 } ] },
    { "wait": 30, "capture": "delivered" },
    { "press": "interact" },
    { "wait": 60, "capture": "after that" }
  ],
  "print": ["require('lib.state').delivered.hazel", "require('lib.state').carrying", "nova.current_scene()"],
  "out": "build/route_hazel"
}
