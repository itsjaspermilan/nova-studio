{
  "size": "1280x720",
  "start_scene": "office",
  "route": [
    { "wait": 30, "capture": "office" },
    { "walk_to": [2.6, 1.1], "capture": "at the shelf" },
    { "press": "act" },
    { "wait": 30, "capture": "the label" },
    { "press": "act" },
    { "wait": 10 },
    { "walk_to": [0.9, 1.6] },
    { "hold": ["up"], "until": "nova.scene_now().leaving ~= nil", "max": 200, "lua": "require('lib.camera').state.yaw = 0" },
    { "until": "nova.current_scene() == 'valley'", "max": 120 },
    { "wait": 70, "capture": "out on the porch" },
    { "walk_to": "van", "max": 600, "may_time_out": true },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van'", "max": 400, "capture": "in the van" },
    { "lua": "nova.named('van').autopilot = require('lib.autopilot').to('hazel')" },
    { "until": "nova.named('van').autopilot.done", "max": 3000, "capture": "at No. 3" },
    { "press": "van" },
    { "until": "nova.scene_now().seq == nil", "max": 120, "capture": "got out" },
    { "lua": "local s = nova.scene_now(); local x, z = s:van_point({ 0, 0, -2.75 }); nova.named('postmaster').walk_to = { x, z }" },
    { "until": "nova.named('postmaster').walk_to == nil", "max": 300 },
    { "press": "act" },
    { "until": "require('lib.cards').active()", "max": 120, "capture": "label from the van" },
    { "wait": 20 },
    { "press": "act" },
    { "lua": "nova.scene_now():lead_to('hazel')" },
    { "until": "nova.named('postmaster').walk_to == nil and #(nova.named('postmaster').walk_path or {}) == 0", "max": 900, "capture": "at Hazel's" },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 200 },
    { "press": "act" },
    { "wait": 50, "capture": "Hazel 1" },
    { "repeat": 30, "until": "require('lib.state').delivered.hazel", "steps": [ { "press": "act" }, { "wait": 40 } ] },
    { "wait": 30, "capture": "delivered" },
    { "press": "act" },
    { "wait": 60, "capture": "after that" }
  ],
  "print": ["require('lib.state').delivered.hazel", "require('lib.state').carrying", "nova.current_scene()"],
  "out": "build/route_hazel"
}
