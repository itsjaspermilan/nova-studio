{
  "size": "1280x720",
  "start_scene": "valley",
  "lua": "T = require('lib.testkit'); S = require('lib.state'); S.on_shelf.hazel, S.on_shelf.pip = false, false; S.carrying = 'hazel'; S.van_load = { 'pip' }",
  "route": [
    { "wait": 40, "capture": "ui_card_two_parcels" },
    { "press": "next" },
    { "wait": 10, "capture": "ui_card_after_r1" },
    { "press": "prev" },
    { "wait": 10 },
    { "lua": "S.carrying = nil; S.van_load = { 'hazel', 'pip' }; T.to_van('back')" },
    { "until": "not T.walking()", "max": 900 },
    { "until": "nova.scene_now():picker() ~= nil", "max": 120 },
    { "wait": 20, "capture": "ui_van_panel_two" },
    { "press": "next" },
    { "wait": 10, "capture": "ui_van_panel_two_after_r1" },
    { "lua": "S.van_load = { 'hazel' }" },
    { "wait": 10, "capture": "ui_van_panel_one" },
    { "lua": "S.van_load = { 'pip' }; S.carrying = 'hazel'" },
    { "wait": 10, "capture": "ui_prompt_load" },
    { "lua": "S.carrying = nil; local s = nova.scene_now(); local p = nova.named('postmaster'); p.x, p.z = s:van_point(s.DOOR)" },
    { "wait": 30, "capture": "ui_prompt_get_in" },
    { "lua": "nova.scene_now():get_in()" },
    { "hold": ["go"], "frames": 120 },
    { "hold": ["brake"], "until": "nova.named('van'):stopped()", "max": 400 },
    { "wait": 20, "capture": "ui_prompt_driving" },
    { "lua": "nova.scene_now():get_out(); S.carrying = 'hazel'; local p = nova.named('postmaster'); p.x, p.z = 150, 36" },
    { "walk_to": "hazel", "max": 600 },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 200 },
    { "wait": 5, "capture": "ui_prompt_hand_over" },
    { "press": "interact" },
    { "wait": 150, "capture": "ui_dialogue_hazel" },
    { "repeat": 12, "until": "not require('lib.dialogue').active()", "steps": [ { "press": "interact" }, { "wait": 20 } ] },
    { "wait": 20, "lua": "S.carrying = 'pip'; local p = nova.named('postmaster'); p.x, p.z = -178, 100" },
    { "walk_to": "pip", "max": 600 },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 200 },
    { "press": "interact" },
    { "wait": 120, "capture": "ui_dialogue_pip" }
  ],
  "out": "build/ui_valley"
}
