{
  "start_scene": "office",
  "lua": "T = require('lib.testkit'); S = require('lib.state'); C = require('lib.camera'); GO = function(x, z) local p = nova.named('postmaster'); p.x, p.z, p.face = x, z, 3.14; p.speed = 0; p.walk_to = nil; p.walk_path = nil end",
  "route": [
    { "wait": 60, "capture": "office_1_start" },
    { "lua": "nova.named('postmaster').walk_to = T.shelf_spot('hazel')" },
    { "until": "not T.walking()", "max": 600 },
    { "wait": 12, "capture": "office_2_at_tile" },
    { "press": "interact" },
    { "wait": 40 },
    { "press": "interact" },
    { "wait": 30, "capture": "office_3_taken" },
    { "lua": "S.carrying = nil; S.delivered.hazel = true; S.came_out = true; nova.goto_scene('office')" },
    { "wait": 60, "capture": "office_4_one_delivered" },
    { "lua": "C.pinned = { 1.6, 3.0, 2.2, 3.0, 0.9, -2.8, 26 }" },
    { "wait": 5, "capture": "office_5_hatch_close" },
    { "lua": "C.pinned = nil; GO(-2.4, 1.2); nova.named('postmaster').walk_path = { { -2.4, -0.6 }, { -2.4, -1.5 } }" },
    { "wait": 55, "capture": "office_6_left_end_walking" },
    { "lua": "GO(2.55, 1.2); nova.named('postmaster').walk_path = { { 2.55, -0.6 }, { 2.55, -1.5 } }" },
    { "wait": 55, "capture": "office_7_right_end_walking" },
    { "lua": "GO(0.9, 1.8)" },
    { "wait": 20, "capture": "office_8_door_end" }
  ],
  "out": "build/gallery"
}
