{
  "start_scene": "title",
  "lua": "T = require('lib.testkit'); S = require('lib.state'); CARDS = require('lib.cards'); DLG = require('lib.dialogue'); W = require('lib.words'); LONGEST = function(who) local best = ''; local p = W.people[who]; for _, k in ipairs({ 'given', 'after', 'without' }) do local v = p[k]; if type(v) == 'string' then v = { v } end; for _, s in ipairs(v) do if #s > #best then best = s end end end; return best end",
  "route": [
    { "wait": 80, "capture": "ui-01-title" },
    { "lua": "nova.goto_scene('office')" },
    { "wait": 40 },
    { "lua": "CARDS.open('letter')" },
    { "wait": 40, "capture": "ui-02-letter" },
    { "lua": "CARDS.close()" },
    { "wait": 5, "lua": "CARDS.open('pause')" },
    { "wait": 20, "capture": "ui-05-pause" },
    { "lua": "CARDS.close()" },
    { "wait": 5, "lua": "CARDS.open('map')" },
    { "wait": 30, "capture": "ui-06-map" },
    { "lua": "CARDS.close()" },
    { "wait": 5, "lua": "CARDS.open('ending')" },
    { "wait": 200, "capture": "ui-07-end-card" },
    { "lua": "CARDS.close()" },
    { "lua": "S.carrying = nil; nova.goto_scene('valley')" },
    { "wait": 90, "capture": "ui-08-on-foot-prompts" },
    { "lua": "S.carrying = 'hazel'; S.on_shelf.hazel = false" },
    { "wait": 10, "capture": "ui-09-corner-one-parcel" },
    { "lua": "S.van_load = { 'pip' }" },
    { "wait": 10, "capture": "ui-10-corner-two-parcels" },
    { "lua": "T.lead('hazel')" },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 900 },
    { "wait": 20, "lua": "nova.named('postmaster').walk_to, nova.named('postmaster').walk_path = nil, {}" },
    { "lua": "DLG.start('hazel', 'Hazel Brock', { LONGEST('hazel') })" },
    { "wait": 260, "capture": "ui-11-dialogue-hazel-longest" },
    { "lua": "DLG.start('pip', 'Pip Tansy', { LONGEST('pip') })" },
    { "wait": 200, "capture": "ui-12-dialogue-pip-longest" }
  ],
  "out": "build/gallery_ui"
}
