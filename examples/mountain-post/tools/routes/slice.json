{
  "size": "1280x720",
  "lua": "T = require('lib.testkit')",
  "route": [
    { "wait": 60, "capture": "title" },
    { "press": "act" },
    { "until": "nova.current_scene() == 'office'", "max": 120 },
    { "wait": 40, "capture": "the room" },
    { "walk_to": [0.9, 0.35], "max": 300 },
    { "press": "act" },
    { "wait": 40, "capture": "the letter" },
    { "press": "act" },
    { "wait": 10 },
    { "lua": "nova.named('postmaster').walk_to = T.shelf_spot('hazel')" },
    { "until": "not T.walking()", "max": 300 },
    { "press": "act" },
    { "wait": 30, "capture": "Hazel's label" },
    { "press": "act" },
    { "wait": 10 },
    { "lua": "nova.named('postmaster').walk_path = { { 0.9, 1.6 }, { 0.9, 2.7 } }" },
    { "until": "nova.current_scene() == 'valley'", "max": 400 },
    { "wait": 70, "capture": "out on the porch" },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van' and nova.scene_now().seq == nil", "max": 400, "capture": "in the van" },
    { "lua": "T.drive('hazel')" },
    { "until": "T.arrived()", "max": 3600, "capture": "at No. 3" },
    { "press": "van" },
    { "until": "nova.scene_now().seq == nil", "max": 120 },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "act" },
    { "until": "require('lib.cards').active()", "max": 120 },
    { "wait": 20 },
    { "press": "act" },
    { "lua": "T.lead('hazel')" },
    { "until": "not T.walking() and nova.scene_now():resident_near() ~= nil", "max": 900 },
    { "press": "act" },
    { "wait": 40, "capture": "Hazel talks" },
    { "repeat": 40, "until": "require('lib.state').delivered.hazel", "steps": [{ "press": "act" }, { "wait": 30 }] },
    { "wait": 20 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van' and nova.scene_now().seq == nil", "max": 400 },
    { "lua": "T.drive('post_office')" },
    { "until": "T.arrived()", "max": 3600, "capture": "back at the post office" },
    { "press": "van" },
    { "until": "nova.scene_now().seq == nil", "max": 120 },
    { "lua": "T.to_office()" },
    { "until": "nova.current_scene() == 'office'", "max": 2400 },
    { "wait": 40 },
    { "lua": "nova.named('postmaster').walk_to = T.shelf_spot('pip')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "act" },
    { "wait": 30, "capture": "Pip's label" },
    { "press": "act" },
    { "wait": 10 },
    { "lua": "nova.named('postmaster').walk_path = { { 0.9, 1.6 }, { 0.9, 2.7 } }" },
    { "until": "nova.current_scene() == 'valley'", "max": 400 },
    { "wait": 60 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van' and nova.scene_now().seq == nil", "max": 400 },
    { "lua": "T.drive('pip')" },
    { "until": "T.arrived()", "max": 3600, "capture": "at No. 7" },
    { "press": "van" },
    { "until": "nova.scene_now().seq == nil", "max": 120 },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "act" },
    { "until": "require('lib.cards').active()", "max": 120 },
    { "wait": 20 },
    { "press": "act" },
    { "lua": "T.lead('pip')" },
    { "until": "not T.walking() and nova.scene_now():resident_near() ~= nil", "max": 900 },
    { "press": "act" },
    { "wait": 30, "capture": "Pip talks" },
    { "repeat": 40, "until": "require('lib.state').delivered.pip", "steps": [{ "press": "act" }, { "wait": 30 }] },
    { "wait": 20 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 1200 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van' and nova.scene_now().seq == nil", "max": 400 },
    { "lua": "T.drive('post_office')" },
    { "until": "T.arrived()", "max": 3600 },
    { "press": "van" },
    { "until": "nova.scene_now().seq == nil", "max": 120 },
    { "lua": "T.to_office()" },
    { "until": "nova.current_scene() == 'office'", "max": 2400 },
    { "until": "require('lib.cards').kind() == 'ending'", "max": 300 },
    { "wait": 200, "capture": "the end card" },
    { "press": "act" },
    { "wait": 60, "capture": "after the end" }
  ],
  "print": ["require('lib.state').delivered.hazel", "require('lib.state').delivered.pip", "require('lib.state').ended", "nova.current_scene()"],
  "out": "build/route_slice"
}
