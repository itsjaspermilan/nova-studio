{
  "size": "1280x720",
  "lua": "T = require('lib.testkit')",
  "route": [
    { "wait": 60, "capture": "title" },
    { "press": "confirm" },
    { "until": "nova.current_scene() == 'office'", "max": 120 },
    { "wait": 40, "capture": "the room" },
    { "walk_to": [0.9, 0.35], "max": 300 },
    { "press": "interact" },
    { "wait": 40, "capture": "the letter" },
    { "press": "interact" },
    { "wait": 10 },
    { "lua": "nova.named('postmaster').walk_to = T.shelf_spot('hazel')" },
    { "until": "not T.walking()", "max": 300 },
    { "press": "interact" },
    { "wait": 40, "capture": "Hazel taken, no popup" },
    { "lua": "nova.named('postmaster').walk_path = { { -2.4, 0.2 }, { 0.9, 1.6 }, { 0.9, 2.7 } }" },
    { "until": "nova.current_scene() == 'valley'", "max": 400 },
    { "wait": 70, "capture": "out on the porch" },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():actions() == 'load'", "max": 60 },
    { "press": "interact" },
    { "wait": 10 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 2400 },
    { "press": "van" },
    { "wait": 45, "capture": "getting in" },
    { "until": "nova.scene_now().mode == 'van'", "max": 400, "capture": "in the van" },
    { "lua": "T.drive('hazel')" },
    { "until": "T.arrived()", "max": 6000, "capture": "at No. 3" },
    { "press": "van" },
    { "wait": 5 },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():picker() ~= nil", "max": 60 },
    { "press": "confirm" },
    { "wait": 10 },
    { "lua": "T.lead('hazel')" },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 900 },
    { "wait": 20, "lua": "nova.named('postmaster').walk_to, nova.named('postmaster').walk_path = nil, {}" },
    { "press": "interact" },
    { "wait": 40, "capture": "Hazel talks" },
    { "repeat": 10, "until": "(require('lib.dialogue').line() or ''):find('Pemberton', 1, true) ~= nil or not require('lib.dialogue').active()", "steps": [{"press": "interact"}, {"wait": 30}] },
    { "wait": 45, "capture": "Hazel: the winter Pemberton shut up shop" },
    { "repeat": 10, "until": "(require('lib.dialogue').line() or ''):find('Thank you', 1, true) ~= nil or not require('lib.dialogue').active()", "steps": [{"press": "interact"}, {"wait": 30}] },
    { "wait": 45, "capture": "Hazel: Thank you" },
    { "repeat": 40, "until": "require('lib.state').delivered.hazel", "steps": [{"press": "interact"}, {"wait": 30}] },
    { "wait": 20 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 2400 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van'", "max": 400 },
    { "lua": "T.drive('post_office')" },
    { "until": "T.arrived()", "max": 6000, "capture": "back at the post office" },
    { "press": "van" },
    { "wait": 5 },
    { "lua": "T.to_office()" },
    { "until": "nova.current_scene() == 'office'", "max": 2400 },
    { "wait": 40 },
    { "lua": "nova.named('postmaster').walk_to = T.shelf_spot('pip')" },
    { "until": "not T.walking()", "max": 2400 },
    { "press": "interact" },
    { "wait": 40, "capture": "Pip taken, no popup" },
    { "lua": "nova.named('postmaster').walk_path = { { -2.4, 0.2 }, { 0.9, 1.6 }, { 0.9, 2.7 } }" },
    { "until": "nova.current_scene() == 'valley'", "max": 400 },
    { "wait": 60 },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():actions() == 'load'", "max": 60 },
    { "press": "interact" },
    { "wait": 10 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 2400 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van'", "max": 400 },
    { "lua": "T.drive('pip')" },
    { "until": "T.arrived()", "max": 6000, "capture": "at No. 7" },
    { "press": "van" },
    { "wait": 5 },
    { "lua": "T.to_van('back')" },
    { "until": "not T.walking()", "max": 2400 },
    { "until": "nova.scene_now():picker() ~= nil", "max": 60 },
    { "press": "confirm" },
    { "wait": 10 },
    { "lua": "T.lead('pip')" },
    { "until": "nova.scene_now():resident_near() ~= nil", "max": 900 },
    { "wait": 20, "lua": "nova.named('postmaster').walk_to, nova.named('postmaster').walk_path = nil, {}" },
    { "press": "interact" },
    { "wait": 30, "capture": "Pip talks" },
    { "repeat": 10, "until": "(require('lib.dialogue').line() or ''):find('bridge', 1, true) ~= nil or not require('lib.dialogue').active()", "steps": [{"press": "interact"}, {"wait": 30}] },
    { "wait": 45, "capture": "Pip: past the creek, the lake side too" },
    { "repeat": 40, "until": "require('lib.state').delivered.pip", "steps": [{"press": "interact"}, {"wait": 30}] },
    { "wait": 20 },
    { "lua": "T.to_van('door')" },
    { "until": "not T.walking()", "max": 2400 },
    { "press": "van" },
    { "until": "nova.scene_now().mode == 'van'", "max": 400 },
    { "lua": "T.drive('post_office')" },
    { "until": "T.arrived()", "max": 6000 },
    { "press": "van" },
    { "wait": 5 },
    { "lua": "T.to_office()" },
    { "until": "nova.current_scene() == 'office'", "max": 2400 },
    { "until": "require('lib.cards').kind() == 'ending'", "max": 300 },
    { "wait": 200, "capture": "the end card" },
    { "press": "interact" },
    { "wait": 60, "capture": "after the end" }
  ],
  "print": ["require('lib.state').delivered.hazel", "require('lib.state').delivered.pip", "require('lib.state').ended", "nova.current_scene()"],
  "out": "build/route_slice"
}
