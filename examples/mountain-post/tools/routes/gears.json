{
  "size": "1280x720",
  "start_scene": "valley",
  "out": "build/gears",
  "lua": "local s = nova.scene_now(); local p = nova.named('postmaster'); p.x, p.z = s:van_point(s.DOOR); s:get_in()",
  "print": ["nova.named('van').gear", "nova.named('van').speed"],
  "route": [
    { "wait": 60, "capture": "gear-P: just in: the lever in P, the handbrake lamp off" },
    { "press": "confirm" },
    { "wait": 10, "capture": "refused: A without the brake: 'Hold the brake to shift'" },
    { "hold": ["brake"], "press": "confirm", "frames": 12, "capture": "gear-R: the brake held, A: into R" },
    { "hold": ["go"], "frames": 90, "capture": "reversing: R2 in R backs up, the beeper" },
    { "hold": ["brake"], "until": "math.abs(nova.named('van').speed) < 0.1", "max": 200 },
    { "hold": ["brake"], "press": "confirm", "frames": 12, "capture": "gear-N: into N" },
    { "hold": ["brake"], "press": "confirm", "frames": 12, "capture": "gear-D: into D" },
    { "hold": ["go"], "frames": 240, "capture": "driving-D" },
    { "press": "confirm" },
    { "hold": ["go"], "frames": 30, "capture": "gear-L: D to L on the move, no brake" },
    { "hold": ["handbrake"], "frames": 20, "capture": "handbrake: B held, the lamp lit" },
    { "hold": ["brake"], "until": "math.abs(nova.named('van').speed) < 0.1", "max": 300 },
    { "wait": 20, "capture": "stopped in L" }
  ]
}
