{
  "size": "1280x720",
  "start_scene": "title",
  "lua": "T = require('lib.testkit'); S = require('lib.state')",
  "route": [
    { "wait": 100, "capture": "ui_title" },
    { "press": "act" },
    { "until": "nova.current_scene() == 'office'", "max": 120 },
    { "wait": 30 },
    { "walk_to": [0.9, 0.35], "max": 300 },
    { "wait": 5, "capture": "ui_prompt_office" },
    { "press": "act" },
    { "wait": 40, "capture": "ui_letter" },
    { "press": "act" },
    { "wait": 20, "lua": "nova.named('postmaster').walk_to = T.shelf_spot('hazel')" },
    { "until": "not T.walking()", "max": 400 },
    { "press": "act" },
    { "wait": 40, "capture": "ui_label" },
    { "press": "act" },
    { "wait": 30, "capture": "ui_card_one_parcel" },
    { "press": "pause" },
    { "wait": 30, "capture": "ui_pause" },
    { "press": "menu_down" },
    { "wait": 10, "capture": "ui_pause_quit_chosen" },
    { "press": "menu_up" },
    { "press": "act" },
    { "wait": 20 },
    { "press": "map" },
    { "wait": 40, "capture": "ui_map" },
    { "press": "map" },
    { "wait": 20 }
  ],
  "out": "build/ui_office"
}
