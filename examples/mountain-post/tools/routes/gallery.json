{
  "size": "1280x720",
  "start_scene": "valley",
  "lua": "T = require('lib.testkit'); IN_VAN = function(x, z, h) local v = nova.named('van'); v:teleport(x, z, h); local s = nova.scene_now(); s.mode = 'van'; v.driven = true; v.engine_on = true; nova.named('postmaster').hidden = true; require('lib.camera').reset(h) end",
  "route": [
    { "wait": 20, "lua": "IN_VAN(4, -150, 0)" },
    { "lua": "T.drive('bridge_out')" },
    { "until": "nova.named('van').z > -98", "max": 1200, "capture": "Post Road, coming up to Fern Lane's sign" },
    { "until": "nova.named('van').z > -80", "max": 600, "capture": "the Fern Lane signpost" },
    { "until": "nova.named('van').z > 0", "max": 1200, "capture": "Post Road north" },
    { "until": "nova.named('van').z > 14", "max": 600, "capture": "Kettle Creek Road's signpost" },
    { "until": "nova.named('van').z > 100", "max": 1200, "capture": "the picnic spot" },
    { "until": "T.arrived()", "max": 1800, "capture": "BRIDGE OUT" },
    { "lua": "local s = nova.scene_now(); s.mode = 'foot'; local p = nova.named('postmaster'); p.hidden = false; p.x, p.z = 21.5, 219; p.face = 0.02; require('lib.camera').reset(0.02); local v = nova.named('van'); v:teleport(26, 205, 0.4)" },
    { "wait": 90, "capture": "the view across the gorge" },
    { "lua": "IN_VAN(-40, -78, 1.75)" },
    { "lua": "T.drive('hazel')" },
    { "until": "nova.named('van').x > 100", "max": 1200, "capture": "Fern Lane" },
    { "until": "nova.named('van').z > 0", "max": 1200, "capture": "Fern Lane, the bend" },
    { "until": "nova.named('van').z > 22", "max": 900, "capture": "Hazel's cabin comes into view" },
    { "until": "T.arrived()", "max": 1200, "capture": "No. 3" },
    { "lua": "IN_VAN(-40, 26, -1.57)" },
    { "lua": "T.drive('pip')" },
    { "until": "nova.named('van').x < -80", "max": 1200, "capture": "Kettle Creek Road, to the bridge" },
    { "until": "nova.named('van').x < -100", "max": 600, "capture": "on the bridge" },
    { "until": "nova.named('van').x < -150", "max": 900, "capture": "Pip's mast" },
    { "until": "T.arrived()", "max": 1200, "capture": "No. 7" },
    { "press": "map" },
    { "wait": 30, "capture": "the paper map" },
    { "press": "map" },
    { "wait": 20 },
    { "press": "pause" },
    { "wait": 20, "capture": "the pause menu" },
    { "press": "act" },
    { "wait": 20 }
  ],
  "out": "build/gallery_run"
}
