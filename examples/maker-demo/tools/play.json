{
  "route": [
    { "wait": 30, "capture": "the meadow" },
    { "hold": ["right"], "until": "nova.named('slime') and nova.named('slime').x - nova.named('hero').x < 60", "max": 120, "capture": "walking right" },
    { "press": "attack" },
    { "wait": 5, "capture": "the swing" },
