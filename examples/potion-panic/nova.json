    "work": ["key:KeyF", "key:KeyQ", "pad:east"],
    "dash": ["key:ShiftLeft", "pad:west", "pad:r1", "axis:r2"],
    "throw": ["key:KeyG", "key:KeyC", "pad:north", "pad:l1"],
    "pause": ["key:Escape", "key:KeyP", "pad:start"],
    "menu_back": ["key:Escape"],
    "stats": ["key:F3"],
    "selftest": ["key:F10"],
    "autoplay": ["key:F9"],
