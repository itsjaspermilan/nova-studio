{
 "start_scene": "market_a",
 "invincible": true,
 "route": [
  {
   "lua": "nova.named('runner').x, nova.named('runner').y = 420, 330"
  },
  {
   "until": "nova.count('warn') > 0",
   "max": 200
  },
  {
   "wait": 6,
   "capture": "the warning marks"
  },
  {
   "wait": 30,
   "capture": "closing in"
  },
  {
   "until": "nova.count('enemy') >= 2",
   "max": 100,
   "capture": "they step out"
  },
  {
   "wait": 8,
   "capture": "wave 1 here"
  },
  {
   "lua": "for _, e in ipairs(nova.all('enemy')) do e:take_hit(99, 0, 0, 0) end"
  },
  {
   "until": "nova.count('warn') > 0",
   "max": 200
  },
  {
   "wait": 12,
   "capture": "wave 2 warns: two points"
  }
 ],
 "out": "build/look_wave",
 "columns": 3
}
