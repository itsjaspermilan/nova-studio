{
 "start_scene": "gutter.boss",
 "lua": "nova.named('coil').manual = true; nova.named('runner').x, nova.named('runner').y = 1056, 600",
 "route": [
  {
   "wait": 25
  },
  {
   "lua": "nova.named('coil').open = true; nova.named('coil').state = 'window'; nova.named('coil').hp = 3; SCRAP0 = require('lib.juice').scrap; local dummy = nova.spawn('rat_drone', 700, 700)"
  },
  {
   "lua": "nova.named('coil'):take_hit(4, 0, 0, 0); BEFORE_STATE = nova.scene_now().state"
  },
  {
   "wait": 40,
   "capture": "the burst begins"
  },
  {
   "wait": 60,
   "capture": "going down"
  },
  {
   "until": "nova.scene_now().state == 'cleared'",
   "max": 400,
   "capture": "gone: cleared"
  },
  {
   "lua": "COIL_LEFT = nova.count('mother_coil'); DOOR_STATE = nova.named('door_out').state"
  },
  {
   "until": "nova.count('card') == 3",
   "max": 200
  },
  {
   "wait": 40,
   "capture": "the cards rise"
  },
  {
   "lua": "SCRAP1 = require('lib.juice').scrap; IDS = ''; RARES = 0; for _, c in ipairs(nova.all('card')) do IDS = IDS .. c.card_id .. ','; if c.def.rarity == 'rare' then RARES = RARES + 1; RC = c end end; DRONES = nova.count('rat_drone'); PAID = nova.scene_now().paid"
  },
  {
   "lua": "nova.named('runner').x, nova.named('runner').y = RC.x, RC.y + 24"
  },
  {
   "wait": 4,
   "capture": "by the rare card"
  },
  {
   "press": "interact"
  },
  {
   "wait": 10,
   "capture": "taken: the door opens"
  },
  {
   "lua": "TAKEN = RC.card_id; HELD = require('lib.run').cards[#require('lib.run').cards]; DOOR2 = nova.named('door_out').state"
  }
 ],
 "print": [
  "BEFORE_STATE",
  "COIL_LEFT",
  "DOOR_STATE",
  "SCRAP0",
  "SCRAP1",
  "PAID",
  "IDS",
  "RARES",
  "DRONES",
  "TAKEN",
  "HELD",
  "DOOR2"
 ]
}
