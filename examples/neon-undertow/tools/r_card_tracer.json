{
 "start_scene": "test_lab",
 "lua": "local r = nova.named('runner'); r.x, r.y, r.facing = 300, 420, 'right'; do local d = nova.named('d1'); d.x, d.y = 380, 420 end",
 "route": [
  {
   "wait": 3
  },
  {
   "press": "attack"
  },
  {
   "until": "nova.named('runner').stats.baton_hits == 1",
   "max": 40
  },
  {
   "lua": "BASE_HIT = nova.named('d1').last_damage; require('lib.run').add_card('tracer', nova.named('runner'))"
  },
  {
   "wait": 40
  },
  {
   "hold": [
    "ranged"
   ],
   "frames": 6
  },
  {
   "wait": 20,
   "capture": "marked"
  },
  {
   "lua": "MARK = string.format('%.2f', nova.named('d1').mark_t or 0); SHOT_TOTAL = nova.named('d1').total"
  },
  {
   "press": "attack"
  },
  {
   "until": "nova.named('runner').stats.baton_hits == 2",
   "max": 40
  },
  {
   "wait": 2,
   "capture": "hit for more"
  },
  {
   "lua": "MARKED_HIT = nova.named('d1').last_damage"
  },
  {
   "wait": 200
  },
  {
   "lua": "MARK_END = nova.named('d1').mark_t or 0"
  },
  {
   "press": "attack"
  },
  {
   "wait": 12
  },
  {
   "until": "nova.named('runner').stats.baton_hits == 3",
   "max": 60
  },
  {
   "wait": 2
  },
  {
   "lua": "AFTER_HIT = nova.named('d1').last_damage"
  }
 ],
 "print": [
  "BASE_HIT",
  "MARK",
  "SHOT_TOTAL",
  "MARKED_HIT",
  "MARK_END",
  "AFTER_HIT"
 ]
}
