{
 "start_scene": "gutter.elite",
 "invincible": true,
 "lua": "local R = require('lib.run'); R.begin_chain(5); R.room = 3",
 "route": [
  { "wait": 6, "capture": "room 4: the tab (ELITE)" },
  { "until": "nova.count('warn') > 0", "max": 200 },
  { "wait": 14, "capture": "ELITE! with its mark" },
  { "wait": 90, "capture": "the elite in the fight (its name over its head)" },
  { "lua": "local R = require('lib.run'); R.room = 7; nova.goto_scene('gutter.boss')" },
  { "until": "nova.current_scene() == 'gutter.boss' and nova.named('runner') ~= nil", "max": 60 },
  { "wait": 14, "capture": "boss name card" },
  { "wait": 60, "capture": "boss name card held" },
  { "wait": 120, "capture": "the fight begins" },
  { "wait": 300, "capture": "the fight: her bar and name" }
 ],
 "print": ["nova.current_scene()", "require('lib.banner').visible()"]
}
