{
 "start_scene": "gutter.s1_square",
 "invincible": true,
 "lua": "require('lib.meta').keys = 0",
 "route": [
  { "wait": 14, "capture": "LET'S GO! slamming in" },
  { "wait": 150, "capture": "a fight: the HUD" },
  { "repeat": 8, "until": "nova.scene_now().state == 'cleared' or nova.scene_now().state == 'cards'", "steps": [ { "fight": "enemy", "attack": "attack", "max": 900, "may_time_out": true }, { "wait": 20 } ] },
  { "until": "nova.scene_now().state == 'cleared'", "max": 200, "may_time_out": true },
  { "wait": 14, "capture": "CLEARED!" },
  { "until": "nova.count('card') == 3", "max": 200 },
  { "wait": 60, "capture": "cards risen: far cues" },
  { "walk_to": "card", "who": "runner", "max": 900 },
  { "wait": 20, "capture": "a card: the prompt and the card panel" },
  { "press": "interact" },
  { "wait": 20, "capture": "card taken" },
  { "walk_to": "door_out", "who": "runner", "max": 400, "may_time_out": true, "reach": 90 },
  { "wait": 6, "capture": "the exit prompt" },
  { "press": "start" },
  { "wait": 4, "capture": "pause" }
 ],
 "print": ["nova.current_scene()", "require('lib.prompt').visible_key()", "require('lib.prompt').count()"]
}
