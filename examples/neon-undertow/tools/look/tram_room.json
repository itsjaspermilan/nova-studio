{
 "start_scene": "test_lab",
 "invincible": true,
 "who": "runner",
 "out": "build/look/tram_room",
 "columns": 3,
 "route": [
  {
   "lua": "require('lib.run').begin_chain(5); nova.goto_scene('gutter.s3_tram')"
  },
  {
   "until": "nova.current_scene() == 'gutter.s3_tram' and nova.named('runner') ~= nil",
   "max": 40
  },
  {
   "lua": "local S = nova.scene_now(); S.state = 'lab'; S.def = { waves = {}, scrap = 0 }; for _, w in ipairs(nova.all('warn')) do w:destroy() end"
  },
  {
   "lua": "TR = nova.all('tram')[1]; local r = nova.named('runner'); r.x, r.y = TR.x + 700, TR.y - 150; TR.c = 10.3; TR.state = 'idle'"
  },
  {
   "until": "TR.state == 'warn'",
   "max": 100
  },
  {
   "wait": 40,
   "capture": "the rail flashes"
  },
  {
   "until": "TR.state == 'cross'",
   "max": 200
  },
  {
   "wait": 22,
   "capture": "the tram comes in"
  },
  {
   "wait": 16,
   "capture": "it crosses"
  },
  {
   "wait": 24,
   "capture": "it passes"
  }
 ]
}