{
 "start_scene": "test_lab",
 "lua": "local r = nova.named('runner'); r.x, r.y, r.facing = 600, 540, 'right'; local m = nova.spawn('mimic_vendor', 900, 540); M_X, M_Y = m.x, m.y",
 "route": [
  {
   "wait": 20,
   "capture": "shut: a vending machine"
  },
  {
   "hold": [
    "right"
   ],
   "until": "nova.first('mimic_vendor'):distance_to(nova.named('runner')) < 200",
   "max": 200,
   "capture": "3 tiles and a bit: still shut"
  },
  {
   "hold": [
    "right"
   ],
   "until": "nova.first('mimic_vendor').state == 'flicker'",
   "max": 60
  },
  {
   "wait": 5,
   "capture": "flicker: the three lanes"
  },
  {
   "wait": 10,
   "capture": "flicker"
  },
  {
   "until": "nova.first('mimic_vendor').state == 'spit'",
   "max": 60
  },
  {
   "wait": 3,
   "capture": "spits"
  },
  {
   "wait": 10,
   "capture": "cans"
  },
  {
   "wait": 12,
   "capture": "cans, later"
  }
 ],
 "print": [
  "FAR_STATE",
  "string.format('%.0f', FAR_DIST)",
  "SHOT_HP",
  "SHOT_STATE",
  "EDGE_STATE",
  "string.format('%.0f', EDGE_DIST)",
  "BATON_HP",
  "BATON_STATE",
  "NCANS",
  "CANS",
  "M_MOVED"
 ],
 "out": "build/look_mimic",
 "columns": 3,
 "zoom": 2,
 "crop_to": "mimic_vendor",
 "crop_margin": 130
}
