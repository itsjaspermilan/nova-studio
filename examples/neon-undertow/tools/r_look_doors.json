{
 "start_scene": "market_a",
 "invincible": true,
 "lua": "nova.named('runner').x, nova.named('runner').y = 1700, 576",
 "route": [
  {
   "wait": 8,
   "capture": "open, before the fight"
  },
  {
   "wait": 24,
   "capture": "shut"
  },
  {
   "lua": "local S = nova.scene_now(); S.state = 'fight'; S.wave_i = #S.def.waves; S.countdown = nil"
  },
  {
   "wait": 6,
   "capture": "unlocked: cyan light, bars still down"
  },
  {
   "until": "nova.count('card') == 3",
   "max": 200
  },
  {
   "wait": 30
  },
  {
   "lua": "local c = nova.all('card')[1]; nova.named('runner').x, nova.named('runner').y = c.x, c.y + 24"
  },
  {
   "wait": 4
  },
  {
   "press": "interact"
  },
  {
   "wait": 3,
   "capture": "card taken: the door opens"
  },
  {
   "lua": "nova.named('runner').x, nova.named('runner').y = 1700, 576"
  },
  {
   "wait": 20,
   "capture": "open"
  }
 ],
 "out": "build/look_doors",
 "columns": 3,
 "zoom": 2,
 "crop_to": "door_e",
 "crop_margin": 120
}
