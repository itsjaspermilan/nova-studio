{
 "start_scene": "test_lab",
 "lua": "do local d = nova.named('d1'); d.x, d.y = 1300, 120 end; do local d = nova.named('d2'); d.x, d.y = 1300, 420 end; do local d = nova.named('d3'); d.x, d.y = 1300, 760 end; local r = nova.named('runner'); r.x, r.y, r.facing = 120, 420, 'right'; require('lib.run').add_card('slipstream', nova.named('runner'))",
 "route": [
  {
   "wait": 2
  },
  {
   "lua": "X0 = nova.named('runner').x"
  },
  {
   "hold": [
    "right"
   ],
   "frames": 30
  },
  {
   "lua": "BASE = nova.named('runner').x - X0; nova.named('runner').x = 120"
  },
  {
   "hold": [
    "right"
   ],
   "tap": "dash",
   "tap_every": 200,
   "until": "nova.named('runner').state == 'roll'",
   "max": 6
  },
  {
   "until": "nova.named('runner').state ~= 'roll'",
   "max": 40
  },
  {
   "lua": "X1 = nova.named('runner').x; SLIP = string.format('%.2f', nova.named('runner').slip_t)"
  },
  {
   "hold": [
    "right"
   ],
   "frames": 30,
   "capture": "faster"
  },
  {
   "lua": "FAST = nova.named('runner').x - X1; nova.named('runner').x = 120"
  },
  {
   "wait": 100
  },
  {
   "lua": "X2 = nova.named('runner').x; SLIP_END = string.format('%.2f', nova.named('runner').slip_t)"
  },
  {
   "hold": [
    "right"
   ],
   "frames": 30
  },
  {
   "lua": "AFTER = nova.named('runner').x - X2; RATIO = string.format('%.2f', FAST / BASE)"
  }
 ],
 "print": [
  "string.format('%.1f', BASE)",
  "string.format('%.1f', FAST)",
  "SLIP",
  "SLIP_END",
  "string.format('%.1f', AFTER)",
  "RATIO"
 ]
}
