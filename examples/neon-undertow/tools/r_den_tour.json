{
 "start_scene": "title",
 "lua": "require('lib.meta').keys = 40",
 "route": [
  {
   "wait": 25,
   "capture": "the title"
  },
  {
   "press": "interact"
  },
  {
   "wait": 30,
   "capture": "printing: the bed, LULLABY's first line"
  },
  {
   "lua": "WAKE_LINE = nova.scene_now().line; WAKE_KIND = nova.scene_now().line_kind; WAKE_STATE = nova.scene_now().state"
  },
  {
   "wait": 60
  },
  {
   "press": "interact"
  },
  {
   "until": "nova.scene_now().state == 'free' or nova.scene_now().state == 'movein'",
   "max": 200
  },
  {
   "wait": 3
  },
  {
   "lua": "FREE = nova.scene_now().state; DEN_SCENE = nova.current_scene()"
  },
  {
   "wait": 5,
   "capture": "the Den"
  },
  {
   "walk_to": "screen",
   "who": "runner",
   "max": 900
  },
  {
   "wait": 3,
   "capture": "at LULLABY's screen"
  },
  {
   "press": "interact"
  },
  {
   "wait": 3,
   "capture": "she talks"
  },
  {
   "lua": "SCREEN_SET = nova.scene_now().panel.set; SCREEN_N = #nova.scene_now().panel.lines"
  },
  {
   "repeat": 6,
   "until": "nova.scene_now().state == 'free'",
   "steps": [
    {
     "press": "interact"
    },
    {
     "wait": 6
    }
   ]
  },
  {
   "walk_to": "stall_patch",
   "who": "runner",
   "max": 900
  },
  {
   "wait": 3,
   "capture": "an empty stall: its plate"
  },
  {
   "press": "interact"
  },
  {
   "wait": 3,
   "capture": "the plate"
  },
  {
   "lua": "PLATE = nova.scene_now().panel.text"
  },
  {
   "press": "interact"
  },
  {
   "wait": 4
  },
  {
   "walk_to": "bench",
   "who": "runner",
   "max": 900
  },
  {
   "wait": 3,
   "capture": "at the Workbench"
  },
  {
   "press": "interact"
  },
  {
   "wait": 4,
   "capture": "the Workbench's screen"
  },
  {
   "lua": "BENCH = nova.scene_now().state; SEL0 = nova.scene_now().sel"
  },
  {
   "hold": [
    "down"
   ],
   "frames": 5
  },
  {
   "wait": 3
  },
  {
   "lua": "SEL1 = nova.scene_now().sel"
  },
  {
   "hold": [
    "up"
   ],
   "frames": 5
  },
  {
   "wait": 3
  },
  {
   "press": "interact"
  },
  {
   "wait": 6,
   "capture": "bought: Thicker Print"
  },
  {
   "lua": "KEYS_AFTER = require('lib.meta').keys; TIER = require('lib.meta').upgrades.thicker_print; TOAST = nova.scene_now().toast"
  },
  {
   "press": "interact"
  },
  {
   "wait": 6
  },
  {
   "lua": "KEYS_AFTER2 = require('lib.meta').keys; TIER2 = require('lib.meta').upgrades.thicker_print"
  },
  {
   "press": "dash"
  },
  {
   "wait": 4,
   "capture": "closed"
  },
  {
   "lua": "CLOSED = nova.scene_now().state"
  },
  {
   "walk_to": "rundoor",
   "who": "runner",
   "max": 900
  },
  {
   "wait": 3,
   "capture": "the door"
  },
  {
   "press": "interact"
  },
  {
   "until": "nova.current_scene() == require('lib.run').chain[1].scene and nova.named('runner') ~= nil",
   "max": 60
  },
  {
   "until": "not require('lib.wipe').busy()",
   "max": 240
  },
  {
   "wait": 5,
   "capture": "room 1"
  },
  {
   "lua": "RUN_MAX = nova.named('runner').max_hp; ROOM1 = nova.current_scene(); FROM_DEN = tostring(require('lib.run').from_den)"
  }
 ],
 "print": [
  "WAKE_KIND",
  "WAKE_STATE",
  "WAKE_LINE",
  "FREE",
  "DEN_SCENE",
  "SCREEN_SET",
  "SCREEN_N",
  "PLATE",
  "BENCH",
  "SEL0",
  "SEL1",
  "KEYS_AFTER",
  "TIER",
  "TOAST",
  "KEYS_AFTER2",
  "TIER2",
  "CLOSED",
  "RUN_MAX",
  "ROOM1",
  "FROM_DEN"
 ]
}
