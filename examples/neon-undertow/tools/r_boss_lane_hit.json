{
 "start_scene": "gutter.boss",
 "lua": "require('data.flow').boss_delay = 0; nova.named('coil').manual = true; nova.named('runner').x, nova.named('runner').y = 1000, 624",
 "route": [
  {
   "wait": 25
  },
  {
   "lua": "HP0 = nova.named('runner').hp; nova.named('coil'):cast('lanes'); ROWS = ''; for _, l in ipairs(nova.all('coil_lane')) do ROWS = ROWS .. string.format('%.0f ', l.y) end"
  },
  {
   "wait": 40,
   "capture": "the lanes are lit"
  },
  {
   "wait": 40,
   "capture": "the junk comes"
  },
  {
   "until": "nova.count('coil_lane') == 0",
   "max": 400
  },
  {
   "wait": 5,
   "capture": "after"
  },
  {
   "lua": "HP1 = nova.named('runner').hp"
  }
 ],
 "print": [
  "HP0",
  "HP1",
  "ROWS"
 ]
}
