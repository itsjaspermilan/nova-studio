{
 "start_scene": "den",
 "lua": "require('lib.meta').keys = 7; require('lib.meta').last = 'first'",
 "route": [
  {
   "until": "nova.current_scene() == 'den' and nova.named('runner') ~= nil",
   "max": 60
  },
  {
   "wait": 60
  },
  {
   "press": "interact"
  },
  {
   "until": "nova.scene_now().state == 'free' or nova.scene_now().state == 'movein'",
   "max": 200
  },
  {
   "wait": 3
  },
  {
   "lua": "LINE0 = nova.scene_now().line_kind"
  },
  {
   "walk_to": "rundoor",
   "who": "runner",
   "max": 900
  },
  {
   "press": "interact"
  },
  {
   "until": "nova.current_scene() == require('lib.run').chain[1].scene and nova.named('runner') ~= nil",
   "max": 60
  },
  {
   "until": "not require('lib.wipe').busy()",
   "max": 240
  },
  {
   "wait": 5
  },
  {
   "lua": "require('lib.juice').scrap = 40; nova.named('runner').hp = 1; nova.named('runner'):take_damage(2)"
  },
  {
   "until": "nova.current_scene() == 'summary'",
   "max": 200,
   "capture": "the summary: printed again"
  },
  {
   "lua": "SUM_DEN = tostring(require('lib.run').from_den); LAST = require('lib.meta').last; PRINTS = require('lib.meta').prints"
  },
  {
   "wait": 60
  },
  {
   "press": "interact"
  },
  {
   "until": "nova.current_scene() == 'den' and nova.named('runner') ~= nil",
   "max": 80
  },
  {
   "wait": 30,
   "capture": "the Den: LULLABY's death line"
  },
  {
   "lua": "KIND = nova.scene_now().line_kind; LINE = nova.scene_now().line; STATE = nova.scene_now().state; RUNS = require('lib.meta').runs; IN_RUN = tostring(require('lib.run').active)"
  }
 ],
 "print": [
  "LINE0",
  "SUM_DEN",
  "LAST",
  "PRINTS",
  "KIND",
  "LINE",
  "STATE",
  "RUNS",
  "IN_RUN"
 ]
}
