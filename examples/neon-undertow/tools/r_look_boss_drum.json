  },
  {
   "press": "attack"
  },
  {
   "wait": 3
  },
  {
   "press": "attack"
  },
  {
   "wait": 8,
   "capture": "a hit"
  },
  {
   "wait": 60
  },
  {
   "until": "not nova.named('coil').open",
   "max": 200,
   "capture": "shut again"
  }
 ],
 "out": "build/look_boss_drum",
