file(MAKE_DIRECTORY "${NOVA_PATCH_TEST_DIRECTORY}/src/platforms")
file(COPY "${NOVA_RAYLIB_SOURCE}/src/platforms/rcore_android.c"
    DESTINATION "${NOVA_PATCH_TEST_DIRECTORY}/src/platforms")
set(raylib_SOURCE_DIR "${NOVA_PATCH_TEST_DIRECTORY}")
include("${NOVA_ROOT}/cmake/RaylibAndroid.cmake")
file(READ "${raylib_SOURCE_DIR}/src/platforms/rcore_android.c" first_result)
include("${NOVA_ROOT}/cmake/RaylibAndroid.cmake")
file(READ "${raylib_SOURCE_DIR}/src/platforms/rcore_android.c" second_result)
if(NOT first_result STREQUAL second_result)
    message(FATAL_ERROR "Android lifecycle patch is not idempotent")
endif()
string(REGEX MATCHALL "Nova: leave the blocking event loop" markers "${first_result}")
list(LENGTH markers marker_count)
if(NOT marker_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one Android destruction-loop alteration")
endif()
message(STATUS "Pinned Android destruction-loop patch matches and is idempotent")
