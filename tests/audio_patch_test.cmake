include("${NOVA_ROOT}/cmake/RaylibAudio.cmake")
if(DEFINED NOVA_UNKNOWN_SOURCE)
    nova_patch_raylib_audio("${NOVA_UNKNOWN_SOURCE}")
    return()
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(directory "${NOVA_TEST_DIRECTORY}/audio-patch-${nonce}")
file(MAKE_DIRECTORY "${directory}/src")
file(COPY "${NOVA_RAYLIB_SOURCE}/src/raudio.c" DESTINATION "${directory}/src")
nova_patch_raylib_audio("${directory}")
file(READ "${directory}/src/raudio.c" first)
nova_patch_raylib_audio("${directory}")
file(READ "${directory}/src/raudio.c" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Audio source patch is not idempotent")
endif()
string(REGEX MATCHALL "Nova: stop/join callbacks before destroying their mutex" matches "${first}")
list(LENGTH matches count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one callback-quiescent device-close patch")
endif()
string(FIND "${first}" "ma_device_uninit(&AUDIO.System.device); // Nova: stop/join callbacks before destroying their mutex.\n        ma_mutex_uninit" close_position)
if(close_position EQUAL -1)
    message(FATAL_ERROR "Device close does not quiesce callbacks before mutex destruction")
endif()
file(APPEND "${directory}/src/raudio.c" "\n/* unexpected upstream modification */\n")
file(SHA256 "${directory}/src/raudio.c" unknown_before)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DNOVA_ROOT=${NOVA_ROOT}" "-DNOVA_UNKNOWN_SOURCE=${directory}"
    -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "audio source no longer matches")
    message(FATAL_ERROR "Unknown audio source was not rejected: ${output} ${error}")
endif()
file(SHA256 "${directory}/src/raudio.c" unknown_after)
if(NOT unknown_before STREQUAL unknown_after)
    message(FATAL_ERROR "Rejected upstream audio source was modified")
endif()
file(REMOVE "${directory}/src/raudio.c")
file(REMOVE_RECURSE "${directory}")
message(STATUS "Pinned audio hook is checked, idempotent and rejects unknown source")
