foreach(links "${NOVA_SOUND_LINKS}" "${NOVA_SOUND_NATIVE_LINKS}")
    if(links MATCHES "(^|;)(nova_assets|nova_qt_runtime|raylib|nova_qt_raylib)(;|$)")
        message(FATAL_ERROR "Sound component selected a renderer host instead of leaving that choice to the application: ${links}")
    endif()
endforeach()
if(NOT NOVA_SOUND_LINKS MATCHES "(^|;)nova_audio(;|$)")
    message(FATAL_ERROR "Sound component must use the existing native DSP engine")
endif()
if(NOT NOVA_SOUND_NATIVE_LINKS MATCHES "(^|;)nova_audio_native(;|$)")
    message(FATAL_ERROR "Native audition must use the shared-device adapter")
endif()
