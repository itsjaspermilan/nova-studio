string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(directory "${NOVA_TEST_DIRECTORY}/audio-render-${nonce}")
file(MAKE_DIRECTORY "${directory}")
set(output "${directory}/fixture.wav")
execute_process(COMMAND "${NOVA_RENDER}" "${output}" 44100 pcm24
    RESULT_VARIABLE result OUTPUT_VARIABLE message ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT message MATCHES "352800 stereo frames at 44100 Hz")
    message(FATAL_ERROR "offline renderer failed: ${result}: ${message} ${error}")
endif()
file(SIZE "${output}" size)
if(NOT size EQUAL 2116844)
    message(FATAL_ERROR "PCM24 output has wrong exact length: ${size}")
endif()
file(SHA256 "${output}" before)
execute_process(COMMAND "${NOVA_RENDER}" "${output}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
file(SHA256 "${output}" after)
if(result EQUAL 0 OR NOT before STREQUAL after OR NOT error MATCHES "never replaced")
    message(FATAL_ERROR "no-clobber render did not preserve the previous output: ${error}")
endif()
execute_process(COMMAND "${NOVA_RENDER}" "${directory}/invalid.wav" 96000
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0 OR EXISTS "${directory}/invalid.wav")
    message(FATAL_ERROR "invalid rate was not rejected before writing")
endif()
execute_process(COMMAND "${NOVA_RENDER}" "${directory}/missing/out.wav"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Cannot create render candidate")
    message(FATAL_ERROR "output failure was not explicit: ${error}")
endif()
file(GLOB candidates "${directory}/*.partial-*")
if(candidates)
    message(FATAL_ERROR "offline renderer leaked a candidate: ${candidates}")
endif()
file(REMOVE "${output}")
file(REMOVE_RECURSE "${directory}")
