#!/bin/sh
# zig cc as an aarch64 glibc 2.28 compiler/linker; drops flags zig does not take (the target is set here).
n=$#
while [ "$n" -gt 0 ]; do
    a=$1; shift; n=$((n-1))
    case "$a" in
        --target=*|-nodefaultlibs|-Wl,--fix-cortex-a53-843419) ;;
        -target) shift; n=$((n-1)) ;;
        *) set -- "$@" "$a" ;;
    esac
done
exec zig cc -target aarch64-linux-gnu.2.28 "$@"
