# Nova alteration to pinned raylib 5.5: do not block again after Android requests destruction.
set(nova_android_source "${raylib_SOURCE_DIR}/src/platforms/rcore_android.c")
file(READ "${nova_android_source}" nova_android_code)
set(nova_before "if (platform.app->destroyRequested != 0)\n        {\n            CORE.Window.shouldClose = true;\n        }")
set(nova_after "if (platform.app->destroyRequested != 0)\n        {\n            CORE.Window.shouldClose = true;\n            break; // Nova: leave the blocking event loop on activity destruction.\n        }")
string(FIND "${nova_android_code}" "${nova_after}" nova_already_patched)
if(nova_already_patched EQUAL -1)
    string(FIND "${nova_android_code}" "${nova_before}" nova_patch_position)
    if(nova_patch_position EQUAL -1)
        message(FATAL_ERROR "Pinned raylib Android lifecycle patch no longer matches; review the dependency before building.")
    endif()
    string(REPLACE "${nova_before}" "${nova_after}" nova_android_code "${nova_android_code}")
    file(WRITE "${nova_android_source}" "${nova_android_code}")
endif()
