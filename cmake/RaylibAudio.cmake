function(nova_patch_raylib_audio source_directory)
    set(source "${source_directory}/src/raudio.c")
    file(READ "${source}" code)
    set(before_0 "// Module specific Functions Declaration\n//----------------------------------------------------------------------------------\nstatic void OnLog")
    set(after_0 "// Module specific Functions Declaration\n//----------------------------------------------------------------------------------\n#include \"nova_raylib_audio.inc\" // Nova: shared device evidence, no second backend.\nstatic void OnLog")
    set(before_1 "void InitAudioDevice(void)\n{\n    // Init audio context")
    set(after_1 "void InitAudioDevice(void)\n{\n    if (AUDIO.System.isReady) return;\n    nova_raylib_audio_reset();\n    // Init audio context")
    set(before_2 "config.dataCallback = OnSendAudioDataToDevice;\n    config.pUserData = NULL;")
    set(after_2 "config.dataCallback = OnSendAudioDataToDevice;\n    config.notificationCallback = nova_raylib_audio_notification;\n    config.pUserData = NULL;")
    set(before_3 "    // Mixing happens on a separate thread which means we need to synchronize.")
    set(after_3 "    nova_raylib_audio_configured();\n\n    // Mixing happens on a separate thread which means we need to synchronize.")
    set(before_4 "TRACELOG(LOG_WARNING, \"AUDIO: Failed to start playback device\");\n        ma_device_uninit(&AUDIO.System.device);\n        ma_context_uninit")
    set(after_4 "TRACELOG(LOG_WARNING, \"AUDIO: Failed to start playback device\");\n        ma_device_uninit(&AUDIO.System.device);\n        ma_mutex_uninit(&AUDIO.System.lock); // Nova: release successfully initialized mixer mutex.\n        ma_context_uninit")
    set(before_5 "        ma_mutex_uninit(&AUDIO.System.lock);\n        ma_device_uninit(&AUDIO.System.device);\n        ma_context_uninit")
    set(after_5 "        ma_device_uninit(&AUDIO.System.device); // Nova: stop/join callbacks before destroying their mutex.\n        ma_mutex_uninit(&AUDIO.System.lock);\n        ma_context_uninit")
    set(before_6 "    (void)pDevice;\n\n    // Mixing is basically")
    set(after_6 "    (void)pDevice;\n    nova_raylib_audio_observe(frameCount);\n\n    // Mixing is basically")
    set(before_7 "    // Audio data runs through a format converter\n    ma_data_converter_config converterConfig")
    set(after_7 "    if ((sizeInFrames > 0) && (audioBuffer->data == NULL))\n    {\n        TRACELOG(LOG_WARNING, \"AUDIO: Failed to allocate PCM buffer\");\n        RL_FREE(audioBuffer);\n        return NULL;\n    }\n\n    // Audio data runs through a format converter\n    ma_data_converter_config converterConfig")
    set(before_8 "TRACELOG(LOG_WARNING, \"AUDIO: Failed to create data conversion pipeline\");\n        RL_FREE(audioBuffer);")
    set(after_8 "TRACELOG(LOG_WARNING, \"AUDIO: Failed to create data conversion pipeline\");\n        RL_FREE(audioBuffer->data); // Nova: release partial stream allocation.\n        RL_FREE(audioBuffer);")
    set(clean "${code}")
    foreach(index RANGE 0 8)
        string(REPLACE "${after_${index}}" "${before_${index}}" clean "${clean}")
    endforeach()
    string(SHA256 fingerprint "${clean}")
    if(NOT fingerprint STREQUAL "fbf272ddcad4b34a59382d302f4b59d5cb3e1deee069edd742596b112c54478a")
        message(FATAL_ERROR "Pinned raylib 5.5 audio source no longer matches; review before applying Nova audio hooks.")
    endif()
    set(patched "${clean}")
    foreach(index RANGE 0 8)
        string(FIND "${patched}" "${before_${index}}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Pinned raylib audio hook ${index} no longer matches.")
        endif()
        string(REPLACE "${before_${index}}" "${after_${index}}" patched "${patched}")
    endforeach()
    if(NOT code STREQUAL patched)
        file(WRITE "${source}" "${patched}")
    endif()
endfunction()

# Apply independently to each caller-selected host (ordinary GLFW or Qt-hosted).
# This does not link a particular raylib target into nova_audio_native.
function(nova_configure_raylib_audio target source_directory)
    nova_patch_raylib_audio("${source_directory}")
    target_include_directories("${target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime")
    target_compile_features("${target}" PRIVATE c_std_11)
endfunction()
